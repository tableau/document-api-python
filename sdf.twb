      <aliases enabled="yes"/>
      <column datatype="string" hidden="true" name="[Asset ID (AssetList)]" role="dimension" type="nominal"/>
      <column datatype="string" hidden="true" name="[Asset ID]" role="dimension" type="nominal"/>
      <column datatype="string" hidden="true" name="[Asset Name]" role="dimension" type="nominal"/>
      <column datatype="string" hidden="true" name="[Asset Type]" role="dimension" type="nominal"/>
      <column caption="Time (min)" datatype="datetime" name="[Calculation_1871104940863873027]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="datetrunc('minute',[Time])"/>
      </column>
      <column caption="max time" datatype="datetime" name="[Calculation_1871104941239332882]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="{fixed: max(if [Date] = { FIXED :max([Date])} THEN [Calculation_1871104940863873027] END)}"/>
      </column>
      <column caption="LastDayInDB" datatype="date" hidden="true" name="[Calculation_2124854612850659333]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="{max([Date])}"/>
      </column>
      <column caption="url_date" datatype="string" name="[Calculation_2572822031971500037]" role="dimension" type="nominal">
        <calculation class="tableau" formula="replace(str({fixed:max([Date])}),'-','')"/>
      </column>
      <column caption="url_selector" datatype="string" name="[Calculation_2572822031971663879]" role="dimension" type="nominal">
        <calculation class="tableau" formula="//replace([pSelector],' ','%20')&#10;&#10;replace(case [Calculation_386465155957751811] &#10;    when 'Summary' then 'Generation Assets'&#10;    when 'AB Internal Load' then 'AB Internal Load'&#10;    when 'DCR (Total)' then 'Distributed Contingency Reserve'&#10;    when 'LSSi' then 'Load Shedding Service for Import'&#10;    when 'Net to Grid' then 'Net to Grid Generation'&#10;    when 'Cont. Reserve' then 'Contingency Reserve'&#10;    when 'Interchange' then 'AB Interchange'&#10;&#10;END,' ', '%20')"/>
      </column>
      <column caption="cf_Toggle_ShowHide" datatype="boolean" name="[Calculation_2572822031989010440]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Parameters].[pSelector (copy)] = False then True else False end"/>
      </column>
      <column caption="cMetric" datatype="real" name="[Calculation_386465155945086977]" role="measure" type="quantitative">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 1]&#13;&#10;WHEN  &quot;DCR&quot; THEN [DCR]&#13;&#10;WHEN &quot;MC&quot; THEN [MC]&#13;&#10;WHEN &quot;TNG&quot; THEN [TNG]&#13;&#10;END"/>
      </column>
      <column caption="cSelector" datatype="string" name="[Calculation_386465155957751811]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Parameters].[Parameter 2]"/>
      </column>
      <column caption="Filter - Agent" datatype="boolean" name="[Calculation_386465155969847302]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Parameters].[Parameter 3] = [Pool Participant Name] THEN TRUE else FALSE end"/>
      </column>
      <column caption="label - Blank" datatype="string" name="[Calculation_386465155971223559]" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;&quot;"/>
      </column>
      <column caption="passer - Agent" datatype="string" name="[Calculation_386465155979497482]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Parameters].[Parameter 3] = &quot;All&quot; THEN [Pool Participant Name] ELSE &#13;&#10;    IF [Pool Participant Name] = [Parameters].[Parameter 3] THEN &quot;All&quot; ELSE [Pool Participant Name] END&#13;&#10;END"/>
      </column>
      <column aggregation="Sum" caption="Hide Selection Border" datatype="integer" name="[Calculation_386465156165935119]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 4]&#13;&#10;WHEN 1 THEN 2&#13;&#10;WHEN 2 THEN 1&#13;&#10;END"/>
      </column>
      <column caption="title - Metric" datatype="string" name="[Calculation_386465156298448918]" role="dimension" type="nominal">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;TNG&quot; THEN &quot;Total Net Generation&quot;&#13;&#10;WHEN  &quot;DCR&quot; THEN &quot;Dispactched Contingency Reserve&quot; &#13;&#10;WHEN &quot;MC&quot; THEN &quot;Maximum Capability&quot; &#13;&#10;&#13;&#10;END"/>
