      <column caption="title - y axis" datatype="string" name="[title - Metric (copy)_386465156301041687]" role="dimension" type="nominal">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Summary&quot; THEN [Calculation_386465156298448918]&#13;&#10;WHEN &quot;AB Internal Load&quot; THEN &quot;AB Internal Load&quot; &#13;&#10;WHEN &quot;DCR (Total)&quot; THEN &quot;Total Dispacted Contingency Reserve&quot;&#13;&#10;WHEN &quot;LSSi&quot; THEN &quot;Load Shed Service for Import&quot;&#13;&#10;WHEN &quot;Net to Grid&quot; THEN &quot;Net Generation Delivered to Grid&quot;&#13;&#10;WHEN &quot;Cont. Reserve&quot; THEN &quot;Contingency Reserve&quot;&#13;&#10;WHEN &quot;Interchange&quot; THEN &quot;MegaWatts&quot;        &#13;&#10;&#13;&#10;END"/>
      </column>
      <column caption="title - Metric (mobile)" datatype="string" name="[title - Metric (copy)_488922049126121472]" role="dimension" type="nominal">
        <calculation class="tableau" formula="if [Parameters].[Parameter 2] = &quot;Summary&quot; THEN&#13;&#10;CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;TNG&quot; THEN &quot;Total Net Generation - &quot;&#13;&#10;WHEN  &quot;DCR&quot; THEN &quot;Dispactched Contingency Reserve - &quot; &#13;&#10;WHEN &quot;MC&quot; THEN &quot;Maximum Capability - &quot; &#13;&#10;&#13;&#10;END&#13;&#10;&#13;&#10;ELSE&#13;&#10;&quot;&quot;&#13;&#10;END"/>
      </column>
      <column caption="title - definition" datatype="string" name="[title - color (copy)_386465156310732826]" role="dimension" type="nominal">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Summary&quot; THEN &#13;&#10;        IF [Parameters].[Parameter 1] = &quot;MC&quot; THEN &quot;The max quantity (MW) a generating asset can provide under optimal conditions with ISO rules/tariff compliance&quot; ELSE&#13;&#10;            IF [Parameters].[Parameter 1] = &quot;TNG&quot; THEN &quot;Total Net Generation (Gross Generation minus Asset service)&quot; ELSE&#13;&#10;                IF [Parameters].[Parameter 1] = &quot;DCR&quot; THEN &quot;Dispatched (and Accepted) Contingency Reserve&quot; END &#13;&#10;            END&#13;&#10;        END&#13;&#10;    &#13;&#10;    WHEN &quot;AB Internal Load&quot; THEN &quot;Calculated total AB demand based on all telemetered Control Area Net Generation plus Net Actual Interchange&quot; &#13;&#10;    WHEN &quot;DCR (Total)&quot; THEN &quot;Dipatched Contingency Reserve - The sum of DCR Generation plus DCR Other&quot; &#13;&#10;    WHEN &quot;LSSi&quot; THEN &quot;LSSi = Load Shed Service for Import&quot; &#13;&#10;    WHEN &quot;Net to Grid&quot; THEN &quot;Net generation the ISO determines is delivered to the grid (BAL-002-WECC-AB-2)&quot; &#13;&#10;    WHEN &quot;Cont. Reserve&quot; THEN &quot;Amount of Contingency reserve that should be obtained on average during the hour&quot; &#13;&#10;    WHEN &quot;Interchange&quot; THEN &quot;Control area interchange between AB and BC, Sask &amp; Montana - Defined as Import (-) or Export (+)&quot; &#13;&#10;END"/>
      </column>
      <column caption="title - agent" datatype="string" name="[title - color (copy)_386465156347805724]" role="dimension" type="nominal">
        <calculation class="tableau" formula="if [Parameters].[Parameter 2] = &quot;Summary&quot; THEN [Parameters].[Parameter 3]&#13;&#10;ELSE &quot;&quot;&#13;&#10;&#13;&#10;END"/>
      </column>
      <column caption="title - color" datatype="string" name="[title - y axis (copy)_386465156304695320]" role="dimension" type="nominal">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Summary&quot; THEN &quot;Energy Source&quot;&#13;&#10;WHEN &quot;AB Internal Load&quot; THEN &quot;Energy Source&quot; &#13;&#10;WHEN &quot;DCR (Total)&quot; THEN &quot;Asset Type (Generation/Other)&quot;&#13;&#10;WHEN &quot;LSSi&quot; THEN &quot;LSSi Type&quot;&#13;&#10;WHEN &quot;Net to Grid&quot; THEN &quot;&quot;&#13;&#10;WHEN &quot;Cont. Reserve&quot; THEN &quot;&quot;&#13;&#10;WHEN &quot;Interchange&quot; THEN &quot;BC/Sask/Yukon/Montana&quot;        &#13;&#10;&#13;&#10;END"/>
      </column>
