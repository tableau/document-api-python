      <table>
        <view>
          <datasources>
            <datasource caption="Supply Demand+ (Multiple Connections)" name="federated.1dcxfi30z2hp1q179z1g6085j2ev"/>
            <datasource name="Parameters"/>
          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column caption="pMetric" datatype="string" name="[Parameter 1]" param-domain-type="list" role="measure" type="nominal" value="&quot;TNG&quot;">
              <calculation class="tableau" formula="&quot;TNG&quot;"/>
            </column>
            <column alias="Generation Assets" caption="pSelector" datatype="string" name="[Parameter 2]" param-domain-type="list" role="measure" type="nominal" value="&quot;Summary&quot;">
              <calculation class="tableau" formula="&quot;Summary&quot;"/>
              <aliases>
                <alias key="&quot;Cont. Reserve&quot;" value="Contingency Reserve"/>
                <alias key="&quot;DCR (Total)&quot;" value="Distributed Contingency Reserve"/>
                <alias key="&quot;Interchange&quot;" value="AB Interchange"/>
                <alias key="&quot;LSSi&quot;" value="Load Shedding Service for Import"/>
                <alias key="&quot;Net to Grid&quot;" value="Net to Grid Generation"/>
                <alias key="&quot;Summary&quot;" value="Generation Assets"/>
              </aliases>
