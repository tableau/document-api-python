          <datasource-dependencies datasource="federated.1dcxfi30z2hp1q179z1g6085j2ev">
            <column caption="Time (min)" datatype="datetime" name="[Calculation_1871104940863873027]" role="dimension" type="ordinal">
              <calculation class="tableau" formula="datetrunc('minute',[Time])"/>
            </column>
            <column caption="max time" datatype="datetime" name="[Calculation_1871104941239332882]" role="dimension" type="ordinal">
              <calculation class="tableau" formula="{fixed: max(if [Date] = { FIXED :max([Date])} THEN [Calculation_1871104940863873027] END)}"/>
            </column>
            <column caption="label - Blank" datatype="string" name="[Calculation_386465155971223559]" role="dimension" type="nominal">
              <calculation class="tableau" formula="&quot;&quot;"/>
            </column>
            <column caption="title - Metric" datatype="string" name="[Calculation_386465156298448918]" role="dimension" type="nominal">
              <calculation class="tableau" formula="CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;TNG&quot; THEN &quot;Total Net Generation&quot;&#13;&#10;WHEN  &quot;DCR&quot; THEN &quot;Dispactched Contingency Reserve&quot; &#13;&#10;WHEN &quot;MC&quot; THEN &quot;Maximum Capability&quot; &#13;&#10;&#13;&#10;END"/>
            </column>
            <column caption="Day Week filter (Week)" datatype="boolean" name="[Calculation_676102912337485826]" role="dimension" type="nominal">
              <calculation class="tableau" formula="if [Parameters].[Parameter 5] = &quot;Week&quot; THEN&#10;&#10;    if ([Date]) = {fixed:max([Date])} THEN TRUE&#10;        ELSE&#10;            if [Date] &gt;= {fixed:max([Date])} -7 THEN &#10;               true&#10;            else &#10;                false&#10;            END&#10;        END&#10;    ELSE&#10;    [Day Week filter (copy)_1871104940876656652]&#10;END&#10;&#10;//IF [PDayWeek] = &quot;Day&quot; THEN&#10;  //  if ([Date]) = [Date Max] THEN TRUE&#10;    //ELSE&#10;      //  FALSE&#10;    //END&#10;//ELSE&#10;  //     if [PDayWeek] = &quot;Week&quot; THEN if [Date Max]-([Date]) &lt; 7 THEN TRUE&#10;    //            ELSE&#10;      //              FALSE&#10;        //       END&#10;       // ELSE&#10;         //   if [PDayWeek] = &quot;30 days&quot; THEN if [Date Max]-([Date]) &lt; 30 THEN TRUE&#10;           // ELSE&#10;             //   FALSE&#10;        //    END&#10;     //  END&#10;  //  END&#10;//END"/>
            </column>
            <column datatype="date" name="[Date]" role="dimension" type="ordinal"/>
            <column caption="Day Week filter (day)" datatype="boolean" name="[Day Week filter (copy)_1871104940876656652]" role="dimension" type="nominal">
              <calculation class="tableau" formula="if ([Date]) = {fixed:max([Date])} THEN TRUE&#13;&#10;    ELSE&#13;&#10;        if [Date] = {fixed:max([Date])} -1 THEN &#10;            if [Calculation_1871104940863873027] &gt; [Calculation_1871104941239332882] then&#10;                TRUE&#10;            ELSE&#10;                false&#10;            end&#10;        else &#10;            false&#10;        END&#13;&#10;    END&#13;&#10;&#13;&#10;&#13;&#10;//IF [PDayWeek] = &quot;Day&quot; THEN&#13;&#10;  //  if ([Date]) = [Date Max] THEN TRUE&#13;&#10;    //ELSE&#13;&#10;      //  FALSE&#13;&#10;    //END&#13;&#10;//ELSE&#13;&#10;  //     if [PDayWeek] = &quot;Week&quot; THEN if [Date Max]-([Date]) &lt; 7 THEN TRUE&#13;&#10;    //            ELSE&#13;&#10;      //              FALSE&#13;&#10;        //       END&#13;&#10;       // ELSE&#13;&#10;         //   if [PDayWeek] = &quot;30 days&quot; THEN if [Date Max]-([Date]) &lt; 30 THEN TRUE&#13;&#10;           // ELSE&#13;&#10;             //   FALSE&#13;&#10;        //    END&#13;&#10;     //  END&#13;&#10;  //  END&#13;&#10;//END"/>
            </column>
            <column datatype="datetime" default-format="*hh:mm" name="[Time]" role="dimension" type="ordinal"/>
            <column-instance column="[Calculation_386465155971223559]" derivation="None" name="[none:Calculation_386465155971223559:nk]" pivot="key" type="nominal"/>
