            </column>
            <column alias="Last 7 days" caption="PDayWeek" datatype="string" name="[Parameter 5]" param-domain-type="list" role="measure" type="nominal" value="&quot;Week&quot;">
              <calculation class="tableau" formula="&quot;Week&quot;"/>
              <aliases>
                <alias key="&quot;30 days&quot;" value="30 days (N/A)"/>
                <alias key="&quot;Day&quot;" value="Last 24 Hours"/>
                <alias key="&quot;Week&quot;" value="Last 7 days"/>
