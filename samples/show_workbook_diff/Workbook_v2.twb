            <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_215609858243792898]' />
              <groupfilter function='level-members' level='[tmi:completed_at:ok]' />
