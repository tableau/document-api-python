      <column caption='Task Delay (Minutes)' datatype='integer' name='[Calculation_994169648265351168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([started_at]) THEN&#13;&#10;  DATEDIFF(&apos;minute&apos;, [created_at], NOW())&#13;&#10;ELSE&#13;&#10;  DATEDIFF(&apos;minute&apos;, [created_at],[started_at])&#13;&#10;END' />
      </column>
