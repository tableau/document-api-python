          <datasource-dependencies datasource='postgres.1u32cir0ucvljd17sderr00my3g8'>
            <column caption='Elapsed Time in Seconds' datatype='real' name='[Calculation_215609858243334144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([completed_at]-[created_at])*86400' />
            </column>
            <column caption='Number of Sessions' datatype='integer' name='[Calculation_215609858243624961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([session_id])' />
            </column>
            <column caption='View Load Time' datatype='string' name='[Calculation_215609858243792898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if     [Calculation_215609858243334144] &gt; 10 then &quot;&gt; 10 seconds&quot; &#13;&#10;elseif [Calculation_215609858243334144] &gt; 5 then &quot;5 - 10 seconds&quot; &#13;&#10;elseif [Calculation_215609858243334144] &gt; 3 then &quot;3 - 5 seconds&quot; &#13;&#10;else &quot;&lt; 3 seconds&quot; END' />
            </column>
            <column caption='Completed At' datatype='datetime' name='[completed_at]' role='dimension' type='ordinal' />
