      <repository-location derived-from='https://public.tableau.com/workbooks/TableauServerPerformance/BackgroundJobs?rev=' id='12461698' path='/workbooks/TableauServerPerformance' revision='' />
      <style />
      <datasources>
        <datasource caption='Background Tasks' name='postgres.0ty0f261ifo7rp1bt2tgn0nd71w2' />
      </datasources>
      <datasource-dependencies datasource='postgres.0ty0f261ifo7rp1bt2tgn0nd71w2'>
        <column datatype='string' name='[Job Name (group)]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[job_name]' new-bin='false'>
            <bin value='&quot;Aggregate Analytics&quot;'>
              <value>&quot;Aggregate Analytics&quot;</value>
              <value>&quot;Clean Sheet Image Cache&quot;</value>
              <value>&quot;Cleanup orphaned version content from storage&quot;</value>
              <value>&quot;Cleanup Stale Async and Background Jobs&quot;</value>
              <value>&quot;Dataengine Configuration Reaper&quot;</value>
              <value>&quot;Delete a set of workbook version content&quot;</value>
              <value>&quot;Delete Expired Refresh Tokens&quot;</value>
              <value>&quot;Delete Expired Tickets&quot;</value>
              <value>&quot;Delete Old Background Jobs&quot;</value>
              <value>&quot;Delete Old Index Updates&quot;</value>
              <value>&quot;List Extracts for TDFS deletions&quot;</value>
              <value>&quot;List Extracts for TDFS Propagation&quot;</value>
              <value>&quot;List Extracts for TDFS Reaping&quot;</value>
              <value>&quot;Low Disk Space Monitoring&quot;</value>
              <value>&quot;Purge Expired WG Sessions&quot;</value>
              <value>&quot;Queue Active Directory Groups Sync&quot;</value>
              <value>&quot;Reap Auto Saves&quot;</value>
              <value>&quot;Reap outdated OAuth request tokens from DB&quot;</value>
              <value>&quot;Reap Shared Views&quot;</value>
              <value>&quot;Remove Garbage Repository Records&quot;</value>
              <value>&quot;Remove Unused Audit History Records&quot;</value>
              <value>&quot;Sync Active Directory Group&quot;</value>
              <value>&quot;Verify Search Index&quot;</value>
            </bin>
          </calculation>
          <aliases>
            <alias key='&quot;Aggregate Analytics&quot;' value='Other jobs' />
          </aliases>
        </column>
        <column caption='Job Name' datatype='string' name='[job_name]' role='dimension' type='nominal' />
        <column-instance column='[job_name]' derivation='None' name='[none:job_name:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
