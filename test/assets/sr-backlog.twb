        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='postgres.0gxgzza14t4sv914a66340nj9oip' name='Custom SQL Query' type='text'>with history as (
SELECT i.id, cg.CREATED, ci.oldstring, ci.newstring
FROM jira.changegroup cg 
inner join jira.jiraissue i on cg.issueid = i.id
--inner join jira.project p on i.project = p.id
inner join jira.changeitem ci on ci.groupid = cg.id AND ci.FIELDTYPE=&apos;jira&apos; AND ci.FIELD=&apos;status&apos;
--inner join jira.app_user au on cg.author = au.user_key
--WHERE cg.issueid=(select id from jira.jiraissue where issuenum = 115 and project in (select id from jira.project where pname = &apos;Project name&apos;)) 
where i.project =&apos;10131&apos; and i.issuestatus in (&apos;5&apos;,&apos;6&apos;,&apos;10010&apos;)
--i.id = &apos;10003&apos;
union 
select j.id, j.created, null, &apos;Open&apos;
from jira.jiraissue j 
where j.project =&apos;10131&apos; and j.issuestatus in (&apos;5&apos;,&apos;6&apos;,&apos;10010&apos;)
--j.id = &apos;10003&apos;
order by 1 ,2
)
select *, extract(epoch from ( lag(created) over (partition by id order by id asc, created desc) - created ))/3600 as duration_hours,
first_value (created) over (partition by id order by id asc, created asc) as jira_createddate,
first_value (created) over (partition by id order by id asc, created desc) as jira_closeddate
from history
where (newstring != oldstring or oldstring is null)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='postgres.0gxgzza14t4sv914a66340nj9oip' name='Custom SQL Query' type='text'>with history as (
SELECT i.id, cg.CREATED, ci.oldstring, ci.newstring
