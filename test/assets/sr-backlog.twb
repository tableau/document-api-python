select day, j.assignee, j.assignee_manager, j.assignee_director, j.region, j.labels, count(j.*) as backlog_count
--, date_trunc('month',day) as month,  count(j2.*)
from dates d
left join jiras j
on j.created << day and (j.resolutiondate >>= day or j.resolutiondate is null)
--left join jiras j2
--on j2.created << date_trunc('month',day) and (j2.resolutiondate >>= date_trunc('month',day) or j2.resolutiondate is null)
group by 1,2,3,4,5,6
order by day desc]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
