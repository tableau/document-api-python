      <aliases enabled='yes' />
      <column caption='lastdate' datatype='datetime' name='[Calculation_1069041975912468482]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ATTR({fixed [assignee_manager], [assignee_director], [region]:max([day])})' />
      </column>
      <column caption='lastvalue' datatype='integer' name='[Calculation_1069041975912628227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([day]) = [Calculation_1069041975912468482]&#13;&#10;then sum([backlog_count])&#13;&#10;end' />
      </column>
      <column caption='islast_backlog' datatype='boolean' name='[Calculation_691302557935513618]' role='measure' type='nominal'>
        <calculation class='tableau' formula='Last() == 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Director manager assignee' datatype='string' name='[Calculation_691302557947580439]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Director&apos; then [assignee_director]&#13;&#10;ELSEif [Parameters].[Parameter 2]==&apos;Manager&apos; then [assignee_manager]&#13;&#10;else [assignee]&#13;&#10;end' />
      </column>
      <column caption='isMonth' datatype='boolean' name='[Calculation_691302557952626712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]=&apos;Month&apos;' />
      </column>
      <column caption='isWeek' datatype='boolean' name='[Calculation_691302557952819225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]=&apos;Week&apos;' />
      </column>
      <column caption='has extended_sla label' datatype='boolean' name='[Calculation_691302557960351770]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//CONTAINS([labels],&apos;extended_sla&apos;)&#13;&#10;&#13;&#10;IFNULL(CONTAINS([labels],&apos;extended_sla&apos;),FALSE)&#13;&#10;&#13;&#10;//if ISNULL([labels]) then false&#13;&#10;//elseif CONTAINS([labels],&apos;extended_sla&apos;) then true&#13;&#10;//else false&#13;&#10;//end' />
      </column>
