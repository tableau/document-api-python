        <objects>
          <object caption='HIstory' id='_05E08E74F0A04F8C9FDF4B9500C45CDC'>
            <properties context=''>
              <relation connection='postgres.0gxgzza14t4sv914a66340nj9oip' name='Custom SQL Query' type='text'>with history as (
SELECT i.id, cg.CREATED, ci.oldstring, ci.newstring
FROM jira.changegroup cg 
inner join jira.jiraissue i on cg.issueid = i.id
--inner join jira.project p on i.project = p.id
inner join jira.changeitem ci on ci.groupid = cg.id AND ci.FIELDTYPE=&apos;jira&apos; AND ci.FIELD=&apos;status&apos;
--inner join jira.app_user au on cg.author = au.user_key
--WHERE cg.issueid=(select id from jira.jiraissue where issuenum = 115 and project in (select id from jira.project where pname = &apos;Project name&apos;)) 
where i.project =&apos;10131&apos; and i.issuestatus in (&apos;5&apos;,&apos;6&apos;,&apos;10010&apos;)
--i.id = &apos;10003&apos;
union 
select j.id, j.created, null, &apos;Open&apos;
from jira.jiraissue j 
where j.project =&apos;10131&apos; and j.issuestatus in (&apos;5&apos;,&apos;6&apos;,&apos;10010&apos;)
--j.id = &apos;10003&apos;
order by 1 ,2
)
select *, extract(epoch from ( lag(created) over (partition by id order by id asc, created desc) - created ))/3600 as duration_hours,
first_value (created) over (partition by id order by id asc, created asc) as jira_createddate,
first_value (created) over (partition by id order by id asc, created desc) as jira_closeddate
from history
where (newstring != oldstring or oldstring is null)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='SR backlog' inline='true' name='federated.1fut6jv0wzawf71gwhypx1frd91h' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='drt-ds-stage-cluster.corp.nutanix.com' name='postgres.048cwhn1te3ycz1cruf1k17wgykr'>
            <connection authentication='username-password' class='postgres' dbname='ntnx_ds' odbc-native-protocol='' one-time-sql='' port='5432' server='ds-pgsql-prod.corp.nutanix.com' server-oauth='' username='karthik.krishnasamy' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='postgres.048cwhn1te3ycz1cruf1k17wgykr' name='Custom SQL Query' type='text'><![CDATA[with recursive directors(userkey, directorname) as(
select 
c.user_key,
c.manager,
c.region
--from jira.mapping c
from (select usr as user_key, manager, region from jira.mapping union select user_key, manager, region from jira.mapping) c
left join jira.mapping p on c.manager = p.user_key 
--and c.region = p.region
where c.manager in
('chad','mario.zappadu','dipu.das','david.steele','charissa.mccullers','anders.ljungberg','luis.figueroa','guido.hagemann')
union
select
user_key, directorname, d.region
from directors d
inner join (
select usr as user_key, manager, region from jira.mapping union select user_key, manager, region from jira.mapping
) u3 on d.userkey = u3.manager 
--and d.region = u3.region
) --select * from directors
,dates as(
select generate_series('2019-09-01', current_date+1, '1 days'::interval) as day
),
cwd_user_unique as(
select c.lower_user_name, c.display_name
from jira.cwd_user c
join 
(select id, row_number() over (partition by lower_user_name order by updated_date desc) as rn
from jira.cwd_user
group by 1
) c2 on c.id = c2.id and rn=1
) --select * from cwd_user_unique  
, usernames as (
(select a.user_key, a.lower_user_name, c.display_name 
from jira.app_user a
left join cwd_user_unique c on a.lower_user_name = c.lower_user_name
where display_name is not null 
and a.lower_user_name not like '%\_old'
)
union
select 'Mario Zappadu', null, 'Mario Zappadu'
union
select lower_user_name,  null, display_name from cwd_user_unique
),
usernames2 as (select distinct user_key, display_name from usernames),
jiras as(
select issue.created, issue.resolutiondate, concat(project.pkey,'-', issue.issuenum) as key, 
--issue.assignee, m2.manager as assignee_manager,
u1.display_name as assignee,
case
when issue.assignee = 'ts_kb_reviewers' then u1.display_name
when lower(u1.display_name) like '%serviceability%' then 'serviceability'
when u2.display_name is null then 'Non-Support'
else u2.display_name
end as assignee_manager,
--m2.manager,
case
when lower(u1.display_name) like '%serviceability%' then 'Chad Singleton'
when issue.assignee in ('ts_kb_reviewers','serviceability','TS KB Reviwers') then 'Chad Singleton' -- Added 10/28
when (u1.display_name in ('Jithin AS','Rob Savino') or u2.display_name in ('Jithin AS','Rob Savino')) then 'Chad Singleton'
when u3.display_name is null then 'Non-Support'
else u3.display_name
end as assignee_director,
d.region,
--d.directorname as assignee_director, d.region,
string_agg(l.label,', ') as labels
from jira.jiraissue issue 
left join jira.project project on issue.project = project.id 
left JOIN jira.nodeassociation na ON issue.id = na.source_node_id
left JOIN jira.component c ON na.sink_node_id = c.id 
left join jira.mapping m2 on m2.user_key = issue.assignee
left join jira.label l on l.issue = issue.id and l.label = 'extended_sla'
left join directors d on issue.assignee = d.userkey
left join usernames2 u1 on issue.assignee = u1.user_key
left join usernames2 u2 on m2.manager = u2.user_key
left join usernames2 u3 on d.directorname = u3.user_key
where 
project.pkey = 'SR' and
(c.cname = 'KB/Docs' or na.sink_node_id in ('22640', '13680'))
group by 1,2,3,4,5,6,7
)
select day, j.assignee, j.assignee_manager, j.assignee_director, j.region, j.labels, count(j.*) as backlog_count
--, date_trunc('month',day) as month,  count(j2.*)
from dates d
left join jiras j
on j.created << day and (j.resolutiondate >>= day or j.resolutiondate is null)
--left join jiras j2
--on j2.created << date_trunc('month',day) and (j2.resolutiondate >>= date_trunc('month',day) or j2.resolutiondate is null)
group by 1,2,3,4,5,6
order by day desc]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
