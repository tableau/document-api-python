      <datasource-dependencies datasource='Parameters'>
        <column caption='Group by' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Director&quot;'>
          <calculation class='tableau' formula='&quot;Director&quot;' />
        </column>
