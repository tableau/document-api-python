end as assignee_director,
d.region,
--d.directorname as assignee_director, d.region,
string_agg(l.label,', ') as labels
from jira.jiraissue issue 
left join jira.project project on issue.project = project.id 
left JOIN jira.nodeassociation na ON issue.id = na.source_node_id
left JOIN jira.component c ON na.sink_node_id = c.id 
left join jira.mapping m2 on m2.user_key = issue.assignee
left join jira.label l on l.issue = issue.id and l.label = 'extended_sla'
left join directors d on issue.assignee = d.userkey
left join usernames2 u1 on issue.assignee = u1.user_key
left join usernames2 u2 on m2.manager = u2.user_key
left join usernames2 u3 on d.directorname = u3.user_key
where 
project.pkey = 'SR' and
(c.cname = 'KB/Docs' or na.sink_node_id in ('22640', '13680'))
group by 1,2,3,4,5,6,7
