            <column caption='age bracket' datatype='string' name='[Calculation_6732248179113054209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [age] &lt; 30&#10;then &apos;0 &lt; 30&apos;&#10;elseif 30 &lt;= [age] and [age] &lt; 60&#10;then &apos;30+&apos;&#10;elseif 60 &lt;= [age] and [age] &lt; 90&#10;then &apos;60+&apos;&#10;elseif 90 &lt;= [age] and [age] &lt; 120&#10;then &apos;90+&apos;&#10;elseif 120 &lt;= [age] and [age] &lt; 180&#10;then &apos;120+&apos;&#10;elseif 180 &lt;= [age] and [age] &lt; 365&#10;then &apos;180+&apos;&#10;else &apos;365+&apos;&#10;end' />
