      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1tx0p7i0za98fh1gc4odm03p5b4k].[cnt:created:qk]&quot;' value='Created' />
          <alias key='&quot;[federated.1tx0p7i0za98fh1gc4odm03p5b4k].[cnt:resolutiondate:qk]&quot;' value='Resolved' />
        </aliases>
      </column>
      <column caption='manager_match' datatype='integer' name='[Calculation_1069041975908515840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [assignee_manager]=[assignee_manager (Custom SQL Query)]&#13;&#10;then 1&#13;&#10;end' />
      </column>
      <column caption='director_match' datatype='integer' name='[Calculation_1069041975908667393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [assignee_director]=[assignee_director (Custom SQL Query)]&#13;&#10;then 1&#13;&#10;end' />
      </column>
      <column caption='Director / Manager / User' datatype='string' name='[Calculation_333970115474407424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Director&apos; then [assignee_director]&#13;&#10;ELSEif [Parameters].[Parameter 2]==&apos;Manager&apos; then [assignee_manager]&#10;else [assignee]&#10;end' />
      </column>
      <column caption='is quarter' datatype='integer' name='[Calculation_4596978966794465280]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3]=&apos;Fiscal Quarter&apos;&#10;then 1&#10;end' />
      </column>
      <column caption='is year' datatype='integer' name='[Calculation_4596978968922857478]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3]=&quot;Fiscal Year&quot;&#10;then 1&#10;end' />
      </column>
      <column caption='sla bracket' datatype='string' name='[Calculation_578431094072868864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;, [created],[resolutiondate]) &lt; 30&#13;&#10;then &apos;&lt; 30 days&apos;&#13;&#10;ELSE &apos;30+ days&apos;&#13;&#10;end' />
      </column>
      <column caption='sla good' datatype='integer' name='[Calculation_578431094079242241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_578431094072868864]=&apos;&lt; 30 days&apos;&#13;&#10;then 1&#13;&#10;end' />
      </column>
      <column caption='sla%' datatype='real' name='[Calculation_578431094079496194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([Calculation_578431094079242241])/TOTAL(count([Calculation_578431094072868864]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='isMonth' datatype='integer' name='[Calculation_578431094082707459]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3]=&apos;Month&apos;&#13;&#10;then 1&#13;&#10;end' />
      </column>
      <column caption='_Age' datatype='real' name='[Calculation_6236359636833611776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round((date(TODAY())-date([created]))/30)*30' />
      </column>
      <column caption='age bracket' datatype='string' name='[Calculation_6732248179113054209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [age] &lt; 30&#10;then &apos;0 &lt; 30&apos;&#10;elseif 30 &lt;= [age] and [age] &lt; 60&#10;then &apos;30+&apos;&#10;elseif 60 &lt;= [age] and [age] &lt; 90&#10;then &apos;60+&apos;&#10;elseif 90 &lt;= [age] and [age] &lt; 120&#10;then &apos;90+&apos;&#10;elseif 120 &lt;= [age] and [age] &lt; 180&#10;then &apos;120+&apos;&#10;elseif 180 &lt;= [age] and [age] &lt; 365&#10;then &apos;180+&apos;&#10;else &apos;365+&apos;&#10;end' />
      </column>
      <column caption='extended_sla' datatype='boolean' name='[Calculation_6752795852431290368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//CONTAINS([labels],&apos;extended_sla&apos;)&#10;&#10;IFNULL(CONTAINS([labels],&apos;extended_sla&apos;),FALSE)&#10;&#10;//if ISNULL([labels]) then false&#10;//elseif CONTAINS([labels],&apos;extended_sla&apos;) then true&#10;//else false&#10;//end' />
      </column>
      <column caption='count age' datatype='integer' name='[Calculation_6752795852439871491]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//IFNULL(age,0)&#10;IFNULL( COUNT([age]), 111)' />
      </column>
      <column caption='isLast' datatype='boolean' name='[Calculation_691302557523181571]' role='measure' type='nominal'>
        <calculation class='tableau' formula='Last() == 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='no null days' datatype='boolean' name='[Calculation_691302557549326343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='not ISNULL([day])' />
      </column>
      <column caption='total_backlog' datatype='integer' name='[Calculation_691302557582172175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF {FIXED DATETRUNC(&apos;month&apos;, [day]),[assignee (Custom SQL Query)],[labels (Custom SQL Query)]:&#13;&#10;MAX( DATEPART(&apos;day&apos;, [day])  )}=DATEPART(&apos;day&apos;, day) THEN [backlog_count] End' />
      </column>
      <column caption='null resolution date' datatype='boolean' name='[Calculation_837951016924893185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([resolutiondate])' />
      </column>
      <column caption='backlog at end of month' datatype='integer' name='[Calculation_859343115885608962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if attr([day])= {include [Parameters].[Parameter 2]: max([day])}&#13;&#10;then attr([backlog_count])&#13;&#10;end' />
      </column>
      <column caption='firstdate' datatype='datetime' name='[Calculation_859343115889688580]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//ATTR({include [assignee_manager (Custom SQL Query)], [assignee_director (Custom SQL Query)], [labels],[region]:min([day])})&#13;&#10;MIN([day])' />
      </column>
      <column caption='firstvalue' datatype='integer' name='[Calculation_859343115890106373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF attr(day) = [Calculation_859343115889688580]&#13;&#10;then sum([backlog_count])&#13;&#10;end' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
