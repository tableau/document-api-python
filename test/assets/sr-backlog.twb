              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Director&apos; then [assignee_director]&#13;&#10;ELSEif [Parameters].[Parameter 2]==&apos;Manager&apos; then [assignee_manager]&#10;else [assignee]&#10;end' />
            </column>
